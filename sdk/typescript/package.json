{
  "name": "@zeris/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Zeris Zero-Knowledge Resolution & Integrity System",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "zeris-cli": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "docs": "typedoc",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["solana", "zkp", "zero-knowledge", "blockchain"],
  "author": "Zeris Team",
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.78.0",
    "@solana/spl-token": "^0.3.8",
    "bn.js": "^5.2.1",
    "buffer": "^6.0.3",
    "js-sha256": "^0.9.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.1",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.5",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "jest": "^29.6.1",
    "prettier": "^3.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typedoc": "^0.24.8",
    "typescript": "^5.1.6"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ]
}